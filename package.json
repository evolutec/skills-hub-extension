{
  "name": "skills-hub-extension",
  "displayName": " A Skills Hub",
  "description": "Extension VS Code pour afficher et configurer les skills des agents installés et les repos GitHub dans un webview.",
  "version": "0.0.22",
  "publisher": "skills-hub",
  "icon": "resources/default.png",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:skillsHubView"
  ],
  "main": "out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/evolutec/skills-hub-extension.git"
  },
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "command": "skillsHub.openView",
        "title": "Skills Hub: Ouvrir Skills Hub"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillsHubSidebar",
          "title": "Skills Hub",
          "icon": "resources/sidebar.svg"
        }
      ]
    },
    "views": {
      "skillsHubSidebar": [
        {
          "id": "skillsHubView",
          "name": "Skills Hub",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node ./node_modules/typescript/bin/tsc -p ./",
    "watch": "node ./node_modules/typescript/bin/tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.83.0",
    "typescript": "^5.6.2",
    "vsce": "^2.12.0"
  },
  "dependencies": {}
}
